{
  "manifest_version": 3,
  "name": "Tug",
  "description": "Hands your downloads to Tug, the fast, resumable download manager for Linux.",
  "version": "0.16.1",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "main.js",
    "type": "module"
  }
}
