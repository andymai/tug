{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tug",
  "identifier": "io.github.andymai.Tug",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "cargo build --release --locked -p tug-host",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tug",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "shortDescription": "Fast, resumable downloads",
    "longDescription": "Tug pulls every file over many connections and picks up exactly where it stopped, after a pause, a crash or a dropped connection.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "../../../brand/png/tug-32.png",
      "../../../brand/png/tug-128.png",
      "../../../brand/png/tug-256.png",
      "../../../brand/png/tug-512.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../../../packaging/appimage.desktop.hbs"
      },
      "appimage": {
        "files": {
          "/usr/bin/tug-host": "../../../target/release/tug-host"
        }
      }
    }
  }
}
