{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tug",
  "identifier": "io.github.andymai.Tug",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tug",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../brand/png/tug-32.png",
      "../../../brand/png/tug-128.png",
      "../../../brand/png/tug-256.png",
      "../../../brand/png/tug-512.png"
    ]
  }
}
